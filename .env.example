# --- Database (Supabase / Postgres) ---
# Supabase → Project Settings → Database → Connection string.
# Use the "Transaction" pooler (port 6543) — works locally and on Railway.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# --- Providers ---
# The scaffold ships with mock providers so it runs with no keys.
# Set a provider to "mock" (default) or a real implementation name once wired.
ASR_PROVIDER="mock"        # mock | elevenlabs | assemblyai | deepgram
LLM_PROVIDER="mock"        # mock | anthropic | openai
RENDER_PROVIDER="mock"     # mock | shotstack | creatomate
# Real MP4 output needs STORAGE_PROVIDER=supabase (so the source has a fetchable URL).
# Shotstack:
# SHOTSTACK_API_KEY=""
# SHOTSTACK_ENV="stage"    # stage (free sandbox) | v1 (production)
# Creatomate:
# CREATOMATE_API_KEY=""
LIPSYNC_PROVIDER="mock"    # mock | synclabs | heygen  (spec §6 rewrite pipeline)

# --- Queue / orchestration (Inngest) ---
# USE_INNGEST=true runs the produce pipeline as durable async jobs (transcribe →
# analyze → render as separate retried/concurrency-limited steps). When false,
# the pipeline runs inline in the request (fine for local/dev, not for scale).
USE_INNGEST="false"
# INNGEST_EVENT_KEY=""     # from Inngest Cloud (production)
# INNGEST_SIGNING_KEY=""   # from Inngest Cloud (production)

# Claude model for the LLM/EDL step (used when LLM_PROVIDER=anthropic).
LLM_MODEL="claude-opus-4-8"

# Keys for real providers (unused while *_PROVIDER=mock)
# ElevenLabs Scribe (speech-to-text). Set ASR_PROVIDER=elevenlabs to use it.
# ELEVENLABS_API_KEY=""
# Anthropic Claude (LLM analysis). Set LLM_PROVIDER=anthropic to use it.
# ANTHROPIC_API_KEY=""
# ASSEMBLYAI_API_KEY=""
# DEEPGRAM_API_KEY=""
# OPENAI_API_KEY=""

# --- Storage ---
STORAGE_PROVIDER="local"     # local | supabase
# Local dev: filesystem dir that stands in for object storage.
STORAGE_DIR="./storage"
# Supabase Storage (set STORAGE_PROVIDER=supabase to use it). Create a private
# bucket named below in the Supabase dashboard. SERVICE_ROLE_KEY is server-only.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="media"
