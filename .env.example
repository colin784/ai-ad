# --- Database (Supabase / Postgres) ---
# Supabase → Project Settings → Database → Connection string.
# Use the "Transaction" pooler (port 6543) — works locally and on Railway.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# --- Providers ---
# The scaffold ships with mock providers so it runs with no keys.
# Set a provider to "mock" (default) or a real implementation name once wired.
ASR_PROVIDER="mock"        # mock | elevenlabs | assemblyai | deepgram
LLM_PROVIDER="mock"        # mock | anthropic | openai
RENDER_PROVIDER="mock"     # mock | ffmpeg

# Claude model for the LLM/EDL step (used when LLM_PROVIDER=anthropic).
LLM_MODEL="claude-opus-4-8"

# Keys for real providers (unused while *_PROVIDER=mock)
# ElevenLabs Scribe (speech-to-text). Set ASR_PROVIDER=elevenlabs to use it.
# ELEVENLABS_API_KEY=""
# Anthropic Claude (LLM analysis). Set LLM_PROVIDER=anthropic to use it.
# ANTHROPIC_API_KEY=""
# ASSEMBLYAI_API_KEY=""
# DEEPGRAM_API_KEY=""
# OPENAI_API_KEY=""

# --- Storage ---
STORAGE_PROVIDER="local"     # local | supabase
# Local dev: filesystem dir that stands in for object storage.
STORAGE_DIR="./storage"
# Supabase Storage (set STORAGE_PROVIDER=supabase to use it). Create a private
# bucket named below in the Supabase dashboard. SERVICE_ROLE_KEY is server-only.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="media"
